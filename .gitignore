# Build artifacts
build/
*.o
*.obj
*.exe
*.pdb
*.ilk
*.elf
*.a
*.lib
*.dll
*.so
*.dylib
*.exp

# Python
__pycache__/
*.pyc
.venv/
venv/

# Copyrighted game data -- bring your own legally-obtained JAR
game/*.jar
game/*.zip
game/extracted/
*.jar
*.class
*.bsp
*.str
*.mid
*.bin
*.db
*.map
*.png
# (the runtime ships no art; assets are loaded from the user's JAR at build/runtime)
# ...except the README screenshot of our own running build:
!docs/screenshot.png

# Generated C is reproducible from the JAR -- regenerate with the recompiler
generated/*.c
generated/*.h

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Runtime RecordStore saves the game writes next to the exe / cwd (and slot backups)
*.rms
gameslot*_*.rms

# Dev-menu runtime files (configs, save states, screenshots)
controls.cfg
settings.cfg
savestate*.bin
sstest.bin
shot_*.bmp
