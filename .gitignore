# Copyrighted game data -- bring your own legally-obtained JAR
game/*.jar
game/*.zip
game/extracted/
*.jar
*.class
*.bsp
*.str
*.mid
*.bin
*.db
*.map
*.png
# (the runtime ships no art; assets are loaded from the user's JAR at build/runtime)

# Generated C is reproducible from the JAR -- regenerate with the recompiler
generated/*.c
generated/*.h

